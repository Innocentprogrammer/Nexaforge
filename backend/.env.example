# Copy to backend/.env and fill in. .env is gitignored — never commit real values.

# Public base URL of the Next.js app. Per-guest invite links are built as
# {FRONTEND_URL}/invite/{token}.
FRONTEND_URL=http://localhost:3000

# --- Diamond-tier WhatsApp/SMS sending -------------------------------------
# "console" logs the payload and simulates a result (no spend, no network).
# "twilio" performs real sends and requires the credentials below.
INVITE_SEND_BACKEND=console

# console backend only: comma-separated numbers to treat as not-on-WhatsApp,
# which exercises the SMS fallback path without a live Twilio account.
INVITE_SEND_CONSOLE_UNREACHABLE=

NEXAINVITE_TWILIO_ACCOUNT_SID=
NEXAINVITE_TWILIO_AUTH_TOKEN=
# Must include the channel prefix, e.g. whatsapp:+14155238886
NEXAINVITE_TWILIO_WHATSAPP_FROM=
# Plain E.164 number used for the SMS fallback, e.g. +14155238886
NEXAINVITE_TWILIO_SMS_FROM=
# Approved WhatsApp content template SID, e.g. HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Variables: {{1}} = guest name, {{2}} = invite URL
NEXAINVITE_TWILIO_TEMPLATE_SID=

# Seconds between sends, to stay under Twilio's per-account rate limit.
INVITE_SEND_DELAY_SECONDS=1.0

# Also send an SMS copy when the WhatsApp send SUCCEEDED. Off by default:
# double delivery doubles cost and message volume for guests on WhatsApp.
INVITE_SEND_DUPLICATE_SMS=False

# --- Celery -----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
# True runs tasks inline in the web request (no worker needed — local default).
# Set False and run `celery -A config worker -l info` for real async sends.
CELERY_TASK_ALWAYS_EAGER=True

# --- Razorpay payments ------------------------------------------------------
# Obtain test-mode credentials from the Razorpay Dashboard. Never use live keys
# during local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this same value in the Razorpay webhook settings.
RAZORPAY_WEBHOOK_SECRET=

# Email notifications (safe local default; emails print in the backend terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NexaInvite <no-reply@example.com>

# To send real emails, replace the values above with your provider's SMTP settings:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
