# Copy to backend/.env and fill in. .env is gitignored — never commit real values.

# --- Environment & core security ---------------------------------------------
# "development" (default): DEBUG on, built-in dev SECRET_KEY, http:// allowed.
# "production": the app refuses to start unless SECRET_KEY, ALLOWED_HOSTS and
# https:// CORS_ALLOWED_ORIGINS are set, and DEBUG is False. It also turns on
# the HTTPS redirect, secure cookies and HSTS.
DJANGO_ENV=development
# Production only. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=
# DEBUG=False
# ALLOWED_HOSTS=api.nexainvite.com
# CORS_ALLOWED_ORIGINS=https://nexainvite.com
# CSRF_TRUSTED_ORIGINS=https://nexainvite.com,https://api.nexainvite.com
# HSTS: start with 3600 and raise to 31536000 once HTTPS works everywhere.
# Turn on INCLUDE_SUBDOMAINS / PRELOAD only when every subdomain is HTTPS-only.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# Trust X-Forwarded-Proto from the reverse proxy (only if it overwrites the header).
# TRUST_X_FORWARDED_PROTO=True
# Number of trusted reverse proxies in front of Django (client IP for rate limits
# and the activity log). 0 = none (local runserver), 1 = behind nginx (production
# default), 2 = cloud load balancer + nginx.
# NUM_PROXIES=0
# Celery limits (a real worker only; eager mode ignores them). Diamond sends get
# their own longer limit. Concurrency defaults to the number of CPUs.
# CELERY_TASK_SOFT_TIME_LIMIT=300
# CELERY_TASK_TIME_LIMIT=360
# CELERY_WORKER_CONCURRENCY=2
# Shared cache for rate-limit counters. Required in production (Redis); leave
# empty in development to use an in-memory cache.
# CACHE_URL=redis://:password@redis:6379/1

# --- Logging & monitoring -----------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text          # "json" is the production default
# ADMINS=ops@example.com   # emailed on every unhandled 500 (production only)
# SENTRY_DSN=              # optional; requires `pip install sentry-sdk`

# Public base URL of the Next.js app. Per-guest invite links are built as
# {FRONTEND_URL}/invite/{token}.
FRONTEND_URL=http://localhost:3000

# --- Diamond-tier WhatsApp/SMS sending -------------------------------------
# "console" logs the payload and simulates a result (no spend, no network).
# "twilio" performs real sends and requires the credentials below.
INVITE_SEND_BACKEND=console

# console backend only: comma-separated numbers to treat as not-on-WhatsApp,
# which exercises the SMS fallback path without a live Twilio account.
INVITE_SEND_CONSOLE_UNREACHABLE=

NEXAINVITE_TWILIO_ACCOUNT_SID=
NEXAINVITE_TWILIO_AUTH_TOKEN=
# Must include the channel prefix, e.g. whatsapp:+14155238886
NEXAINVITE_TWILIO_WHATSAPP_FROM=
# Plain E.164 number used for the SMS fallback, e.g. +14155238886
NEXAINVITE_TWILIO_SMS_FROM=
# Approved WhatsApp content template SID, e.g. HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Variables: {{1}} = guest name, {{2}} = invite URL
NEXAINVITE_TWILIO_TEMPLATE_SID=

# Seconds between sends, to stay under Twilio's per-account rate limit.
INVITE_SEND_DELAY_SECONDS=1.0

# Also send an SMS copy when the WhatsApp send SUCCEEDED. Off by default:
# double delivery doubles cost and message volume for guests on WhatsApp.
INVITE_SEND_DUPLICATE_SMS=False

# --- Celery -----------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
# True runs tasks inline in the web request (no worker needed — local default).
# Set False and run `celery -A config worker -l info` for real async sends.
CELERY_TASK_ALWAYS_EAGER=True

# --- Razorpay payments ------------------------------------------------------
# Obtain test-mode credentials from the Razorpay Dashboard. Never use live keys
# during local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure this same value in the Razorpay webhook settings.
RAZORPAY_WEBHOOK_SECRET=

# Email notifications (safe local default; emails print in the backend terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NexaInvite <no-reply@example.com>

# To send real emails, replace the values above with your provider's SMTP settings:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True, and an App Password
# (Google Account > Security > App passwords) — 16 letters, entered WITHOUT spaces or hyphens.
# A malformed password makes Gmail drop the connection (SMTPServerDisconnected), not a 535 error.
# Restart the backend after editing .env; runserver's autoreload does not watch it.
