# NexaInvite production settings for docker-compose.yml.
#   cp .env.production.example .env.production   (never commit .env.production)
#   docker compose --env-file .env.production up -d --build
# Every value marked REQUIRED must be set; compose refuses to start otherwise.

# --- Domains (same site: app + api subdomain) ---------------------- REQUIRED
APP_DOMAIN=nexainvite.com
API_DOMAIN=api.nexainvite.com
APP_URL=https://nexainvite.com
API_URL=https://api.nexainvite.com

# --- Secrets ------------------------------------------------------- REQUIRED
# Generate each with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# (hex only: the Redis password is placed inside a redis:// URL).
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Proxy and HTTPS --------------------------------------------------------
# TLS must end in front of nginx (load balancer or host proxy).
# NUM_PROXIES = proxies in front of Django: 1 = nginx only, 2 = LB + nginx.
NUM_PROXIES=2
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
HTTP_PORT=80

# --- Database ---------------------------------------------------------------
POSTGRES_DB=nexainvite
POSTGRES_USER=nexainvite

# --- Payments (use rzp_test_ keys until the payment flow is signed off) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NexaInvite <no-reply@nexainvite.com>
# Server error emails, e.g. "Ops <ops@example.com>"
ADMINS=

# --- WhatsApp / SMS invites (console = log only, nothing sent) --------------
INVITE_SEND_BACKEND=console
NEXAINVITE_TWILIO_ACCOUNT_SID=
NEXAINVITE_TWILIO_AUTH_TOKEN=
NEXAINVITE_TWILIO_WHATSAPP_FROM=
NEXAINVITE_TWILIO_SMS_FROM=
NEXAINVITE_TWILIO_TEMPLATE_SID=

# --- Monitoring (optional) --------------------------------------------------
SENTRY_DSN=
IMAGE_TAG=latest
